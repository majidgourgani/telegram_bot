# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Telegram ---------------------------------------------------------------
# Get a token from @BotFather. This is used only to BOOTSTRAP the database on
# first run; afterwards the token lives in the DB and is editable from the
# dashboard Settings page.
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Numeric id of the private channel users must join (e.g. -1001234567890).
CHANNEL_ID=0
# Public invite link for the "join" button.
CHANNEL_LINK=https://t.me/+your_invite_hash

# --- Dashboard auth ---------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# --- Paths (usually leave as-is) --------------------------------------------
# SQLite database file. Inside Docker this maps to the shared /data volume.
DATABASE_URL=sqlite:///./data/app.db
# Directory where dashboard-uploaded images (e.g. the mini-course file) go.
UPLOAD_DIR=./data/uploads
